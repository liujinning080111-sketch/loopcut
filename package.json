    "@types/node": "^22.0.0",
    "gifuct-js": "^2.1.2",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
